# Copy to .env.local and adjust. All vars are optional.

# Which homepage `/` serves:
#   city    → TOPY.OS Neon City 3D (default; falls back to TOPY.OS 2D without WebGL)
#   cyber   → TOPY.OS 2D neon-noir portfolio
#   elegant → the dark-luxurious site
# The 2D sites are always reachable directly at /os and /elegant
# regardless of this value. Inlined at build time (static export),
# so changing it requires a rebuild.
NEXT_PUBLIC_SITE_VARIANT=city

# Contact form (TOPY.OS "GET IN TOUCH"). Free, no backend:
# get a key in 30s at https://web3forms.com — enter your email, key is
# emailed instantly. Without it the form falls back to opening the
# visitor's mail client (mailto). Inlined at build → rebuild after setting.
NEXT_PUBLIC_WEB3FORMS_KEY=
